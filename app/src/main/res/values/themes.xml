<?xml version="1.0" encoding="utf-8"?>
<!--
    themes.xml
    ====
    Define o tema visual do aplicativo, baseado no Material Design 3
    (Material Components). A Activity usa este tema para herdar cores,
    tipografia e componentes prontos.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principal do app -->
    <style name="Theme.WeatherApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cor primária (azul) usada em botões, campos e destaques -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Cor de destaque secundária -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Cor da barra de status -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorPrimaryDark</item>
    </style>

</resources>
